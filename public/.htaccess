Options -Indexes
RewriteEngine On

# Route the app's /api/*.php URLs to the PHP backend shipped with the build.
RewriteRule ^api/([a-z_]+\.php)$ backend/api/$1 [END,QSA]

# The backend code is only meant to be reached through the API rewrite above.
RewriteRule ^backend(?:/|$) - [F,END]
RewriteRule ^database(?:/|$) - [F,END]
RewriteRule ^database\.example\.php$ - [F,END]

# Keep real files/directories and send client-side routes to the SPA entrypoint.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
RewriteRule ^ index.html [END]
